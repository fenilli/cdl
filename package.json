{
  "private": true,
  "type": "module",
  "name": "cdl",
  "version": "0.1.0",
  "description": "A declarative language and toolkit for defining command-line interfaces",
  "keywords": [
    "cli",
    "command-line",
    "typescript",
    "declarative",
    "language",
    "dsl",
    "command-tree",
    "argument-parser"
  ],
  "author": "Luiz Gustavo Siqueira Fenilli<gustavofenilli@gmail.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./compiler": {
      "types": "./dist/compiler.d.mts",
      "default": "./dist/compiler.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "default": "./dist/schema.mjs"
    }
  },
  "bin": {
    "cdlc": "./dist/cdlc.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "cdlc": "tsx src/cdlc/index.ts",
    "gen:cli": "tsx scripts/gen-cli.ts",
    "verify:cli": "tsx scripts/verify-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
